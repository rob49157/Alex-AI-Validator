# Server
PORT=8000
HOST=127.0.0.1

# API key — shared secret with the Node backend
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=change_me

# OCR
# Path to tesseract binary if not on PATH (e.g. /usr/local/bin/tesseract)
TESSERACT_CMD=

# Limits
MAX_FILE_SIZE_MB=50
MAX_PAGES_OCR=500
JOB_TIMEOUT_SECONDS=120
MAX_CONCURRENT_JOBS=5

# Embeddings
# Model is hardcoded (not configurable) to prevent supply chain risk
# EMBEDDING_MODEL is for reference only, do not use as runtime config

# ChromaDB
CHROMA_PERSIST_DIR=./chroma_data

# Similarity thresholds
SEMANTIC_SIMILARITY_THRESHOLD=0.92
SIMHASH_SIMILARITY_THRESHOLD=0.85
